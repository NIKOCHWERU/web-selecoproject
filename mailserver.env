# ==============================================================================
# KONFIGURASI KEAMANAN MAILSERVER SELECOPROJECT.COM
# ==============================================================================

# Identitas Server
OVERRIDE_HOSTNAME=mail.selecoproject.com
POSTMASTER_ADDRESS=postmaster@selecoproject.com

# Keamanan TLS / SSL
# Menggunakan sertifikat Let's Encrypt dari server host (/etc/letsencrypt)
SSL_TYPE=letsencrypt
SSL_DOMAIN=mail.selecoproject.com
# Hanya izinkan TLS 1.2 dan TLS 1.3 (Blokir SSLv2, SSLv3, TLS 1.0, TLS 1.1)
# Gunakan 'intermediate' agar Roundcube bisa konek via IMAP plain di Docker network
TLS_LEVEL=intermediate

# Network permissions: izinkan container Roundcube di network yang sama tanpa TLS
PERMIT_DOCKER=network

# Proteksi Anti-Spam & Reputasi Email
ENABLE_RSPAMD=1
ENABLE_OPENDKIM=1
ENABLE_POLICYD_SPF=1
SPOOF_PROTECTION=1

# Keamanan Firewall & Brute-Force Protection
ENABLE_FAIL2BAN=1
FAIL2BAN_BLOCKTYPE=drop
FAIL2BAN_MAXRETRY=5
FAIL2BAN_FINDTIME=600
FAIL2BAN_BANTIME=86400

# Pengaturan Kapasitas & Attachment
# Batas ukuran pesan email: 50MB (52428800 bytes)
POSTFIX_MESSAGE_SIZE_LIMIT=52428800
POSTFIX_MAILBOX_SIZE_LIMIT=0

# Log & Monitoring
LOG_LEVEL=info
ENABLE_UPDATE_CHECK=1
